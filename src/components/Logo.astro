---
import hdspLogo from '~/assets/images/hdsplogo.svg';
---

<span
  class="flex items-center gap-3 rounded-lg border border-primary/30 bg-[#071527cc] px-2.5 py-1.5 shadow-[0_10px_30px_rgba(0,0,0,0.18)] backdrop-blur dark:bg-white/5"
>
  <img src={hdspLogo.src} alt="HDSP logo" class="h-10 md:h-9 w-auto" />
  <span class="text-xl md:text-lg font-bold text-white whitespace-nowrap"> HDSP </span>
</span>

---
import type { ImageMetadata } from 'astro';
import { Icon } from 'astro-icon/components';
import Image from '~/components/common/Image.astro';
import PostTags from '~/components/blog/Tags.astro';

import { APP_BLOG } from 'astrowind:config';
import type { Post } from '~/types';

import { getPermalink } from '~/utils/permalinks';
import { findImage } from '~/utils/images';
import { getFormattedDate } from '~/utils/utils';

export interface Props {
  post: Post;
}

const { post } = Astro.props;
const image = (await findImage(post.image)) as ImageMetadata | undefined;

const link = APP_BLOG?.post?.isEnabled ? getPermalink(post.permalink, 'post') : '';
---

<article
  class={`tech-panel mx-auto grid max-w-5xl overflow-hidden p-0 intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade ${
    image ? 'lg:grid-cols-[minmax(0,0.95fr)_minmax(0,1.05fr)]' : ''
  }`}
>
  {
    image &&
      (link ? (
        <a class="group relative block h-full bg-[#030b18] p-2" href={link ?? 'javascript:void(0)'}>
          <div class="relative h-64 overflow-hidden rounded-md bg-[#030b18] sm:h-80 lg:h-full lg:min-h-[320px]">
            <Image
              src={image}
              class="h-full w-full rounded-md bg-[#030b18] object-cover transition duration-300 group-hover:scale-[1.03]"
              widths={[400, 900]}
              width={900}
              sizes="(max-width: 900px) 400px, 900px"
              alt={post.title}
              aspectRatio="16:9"
              loading="lazy"
              decoding="async"
            />
          </div>
        </a>
      ) : (
        <div class="relative h-64 overflow-hidden bg-[#030b18] p-2 sm:h-80 lg:h-full lg:min-h-[320px]">
          <Image
            src={image}
            class="h-full w-full rounded-md bg-[#030b18] object-cover"
            widths={[400, 900]}
            width={900}
            sizes="(max-width: 900px) 400px, 900px"
            alt={post.title}
            aspectRatio="16:9"
            loading="lazy"
            decoding="async"
          />
        </div>
      ))
  }

  <div class="flex flex-col justify-center p-6 md:p-8">
    <header>
      <div class="mb-4 flex flex-wrap items-center gap-2 text-sm text-muted">
        <span
          class="inline-flex items-center gap-1.5 rounded-lg border border-primary/20 bg-primary/10 px-3 py-1 font-semibold text-primary"
        >
          <Icon name="tabler:clock" class="h-4 w-4" />
          <time datetime={String(post.publishDate)}>{getFormattedDate(post.publishDate)}</time>
        </span>

        {
          post.author && (
            <span class="inline-flex items-center gap-1.5 rounded-lg border border-primary/20 bg-primary/5 px-3 py-1">
              <Icon name="tabler:user" class="h-4 w-4 text-primary" />
              <span>{post.author.replaceAll('-', ' ')}</span>
            </span>
          )
        }

        {
          post.category && (
            <a
              class="inline-flex items-center gap-1.5 rounded-lg border border-secondary/20 bg-secondary/10 px-3 py-1 font-semibold text-secondary hover:text-primary"
              href={getPermalink(post.category.slug, 'category')}
            >
              <Icon name="tabler:calendar-event" class="h-4 w-4" />
              {post.category.title}
            </a>
          )
        }
      </div>

      <h2 class="mb-3 font-heading text-2xl font-bold leading-tight text-heading dark:text-white sm:text-3xl">
        {
          link ? (
            <a class="inline-block transition duration-200 ease-in hover:text-primary" href={link}>
              {post.title}
            </a>
          ) : (
            post.title
          )
        }
      </h2>
    </header>

    {
      post.excerpt && (
        <p class="text-justify text-base leading-7 text-muted dark:text-slate-400 md:text-lg">{post.excerpt}</p>
      )
    }

    {
      post.tags && Array.isArray(post.tags) ? (
        <footer class="mt-5">
          <PostTags tags={post.tags} />
        </footer>
      ) : (
        <Fragment />
      )
    }
  </div>
</article>

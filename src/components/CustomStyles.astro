---
import '@fontsource-variable/inter';

// 'DM Sans'
// Nunito
// Dosis
// Outfit
// Roboto
// Literata
// 'IBM Plex Sans'
// Karla
// Poppins
// 'Fira Sans'
// 'Libre Franklin'
// Inconsolata
// Raleway
// Oswald
// 'Space Grotesk'
// Urbanist
---

<style is:inline>
  :root {
    --aw-font-sans: 'Inter Variable';
    --aw-font-serif: 'Inter Variable';
    --aw-font-heading: 'Inter Variable';

    --aw-color-primary: rgb(4 51 255);
    --aw-color-secondary: rgb(45 174 54);
    --aw-color-accent: rgb(255 38 0);

    --aw-color-text-heading: rgb(35 31 32);
    --aw-color-text-default: rgb(35 31 32);
    --aw-color-text-muted: rgb(35 31 32 / 76%);
    --aw-color-bg-page: rgb(248 250 255);

    --aw-color-bg-page-dark: rgb(3 8 18);

    ::selection {
      background-color: rgb(255 251 0 / 44%);
      color: rgb(35 31 32);
    }
  }

  .dark {
    --aw-font-sans: 'Inter Variable';
    --aw-font-serif: 'Inter Variable';
    --aw-font-heading: 'Inter Variable';

    --aw-color-primary: rgb(0 209 255);
    --aw-color-secondary: rgb(83 240 179);
    --aw-color-accent: rgb(124 140 255);

    --aw-color-text-heading: rgb(248 252 255);
    --aw-color-text-default: rgb(222 236 247);
    --aw-color-text-muted: rgb(222 236 247 / 82%);
    --aw-color-bg-page: rgb(3 8 18);

    ::selection {
      background-color: rgb(0 209 255 / 42%);
      color: rgb(248 252 255);
    }
  }
</style>

---
import '@fontsource-variable/inter';

// 'DM Sans'
// Nunito
// Dosis
// Outfit
// Roboto
// Literata
// 'IBM Plex Sans'
// Karla
// Poppins
// 'Fira Sans'
// 'Libre Franklin'
// Inconsolata
// Raleway
// Oswald
// 'Space Grotesk'
// Urbanist
---

<style is:inline>
  :root {
    --aw-font-sans: 'Inter Variable';
    --aw-font-serif: 'Inter Variable';
    --aw-font-heading: 'Inter Variable';

    --aw-color-primary: rgb(0 92 132);
    --aw-color-secondary: rgb(0 118 86);
    --aw-color-accent: rgb(62 79 190);

    --aw-color-text-heading: rgb(4 16 31);
    --aw-color-text-default: rgb(8 22 39);
    --aw-color-text-muted: rgb(8 22 39 / 82%);
    --aw-color-bg-page: rgb(245 249 252);

    --aw-color-bg-page-dark: rgb(3 8 18);

    ::selection {
      background-color: rgb(0 209 255 / 35%);
      color: rgb(2 8 23);
    }
  }

  .dark {
    --aw-font-sans: 'Inter Variable';
    --aw-font-serif: 'Inter Variable';
    --aw-font-heading: 'Inter Variable';

    --aw-color-primary: rgb(0 209 255);
    --aw-color-secondary: rgb(83 240 179);
    --aw-color-accent: rgb(124 140 255);

    --aw-color-text-heading: rgb(248 252 255);
    --aw-color-text-default: rgb(222 236 247);
    --aw-color-text-muted: rgb(222 236 247 / 82%);
    --aw-color-bg-page: rgb(3 8 18);

    ::selection {
      background-color: rgb(0 209 255 / 42%);
      color: rgb(248 252 255);
    }
  }
</style>

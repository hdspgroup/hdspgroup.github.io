---
import type { Content as Props } from '~/types';
import Headline from '~/components/ui/Headline.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Image from '~/components/common/Image.astro';
import Button from '~/components/ui/Button.astro';
import ItemGrid from '~/components/ui/ItemGrid.astro';

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  tagline,
  content = await Astro.slots.render('content'),
  callToAction,
  items = [],
  columns,
  image = await Astro.slots.render('image'),
  isReversed = false,
  isAfterContent = false,

  id,
  isDark = false,
  classes = {},
  bg = await Astro.slots.render('bg'),
} = Astro.props;
---

<WidgetWrapper
  id={id}
  isDark={isDark}
  containerClass={`max-w-7xl mx-auto ${isAfterContent ? 'pt-0 md:pt-0 lg:pt-0' : ''} ${classes?.container ?? ''}`}
  bg={bg}
>
  <Headline
    title={title}
    subtitle={subtitle}
    tagline={tagline}
    classes={{
      container: 'max-w-xl sm:mx-auto lg:max-w-2xl',
      title: 'text-4xl md:text-5xl font-bold tracking-normal mb-4 font-heading',
      subtitle: 'max-w-3xl mx-auto sm:text-center text-xl text-muted dark:text-slate-400',
    }}
  />
  <div class="mx-auto max-w-6xl p-4 md:px-8">
    <div class="grid gap-6 lg:grid-cols-2 lg:items-stretch">
      <div class={`self-stretch ${isReversed ? 'lg:order-2' : ''}`}>
        {
          content && (
            <div
              class="tech-panel h-full p-6 text-base leading-7 dark:text-slate-300 md:p-8 md:text-lg md:leading-8 [&_p+p]:mt-4"
              set:html={content}
            />
          )
        }

        {
          callToAction && (
            <div class="mt-4 text-primary">
              <Button variant="link" {...callToAction} />
            </div>
          )
        }
      </div>
      <div aria-hidden="true" class={`self-stretch ${isReversed ? 'lg:order-1' : ''}`}>
        {
          image && (
            <div class="tech-panel relative h-full p-2">
              {typeof image === 'string' ? (
                <Fragment set:html={image} />
              ) : (
                <Image
                  class="h-full min-h-[320px] w-full rounded-md object-cover saturate-[1.08] contrast-[1.05]"
                  width={720}
                  height={520}
                  widths={[400, 720, 960]}
                  sizes="(max-width: 1024px) 100vw, 520px"
                  layout="cover"
                  {...image}
                />
              )}
            </div>
          )
        }
      </div>
    </div>
    <ItemGrid
      items={items}
      columns={columns ?? 3}
      defaultIcon="tabler:check"
      classes={{
        container: 'mt-6 gap-4 md:grid-cols-3 md:gap-6',
        panel: 'tech-panel h-full max-w-none p-5',
        title: 'text-base font-semibold leading-6 dark:text-white ml-2 rtl:ml-0 rtl:mr-2',
        description: 'text-justify hyphens-auto [text-align-last:left] text-sm leading-6 text-muted dark:text-slate-400 ml-2 rtl:ml-0 rtl:mr-2',
        icon:
          'flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-primary/20 bg-primary/10 text-primary p-1.5',
        action: 'text-base font-semibold leading-6 dark:text-white ml-2 rtl:ml-0 rtl:mr-2',
      }}
    />
  </div>
</WidgetWrapper>

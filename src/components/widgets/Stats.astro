---
import type { Stats as Props } from '~/types';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Headline from '~/components/ui/Headline.astro';
import { Icon } from 'astro-icon/components';

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  tagline,
  stats = [],

  id,
  isDark = false,
  classes = {},
  bg = await Astro.slots.render('bg'),
} = Astro.props;
---

<WidgetWrapper id={id} isDark={isDark} containerClass={`max-w-6xl mx-auto ${classes?.container ?? ''}`} bg={bg}>
  <Headline title={title} subtitle={subtitle} tagline={tagline} />
  <div class="grid gap-4 text-center sm:grid-cols-2 lg:grid-cols-4">
    {
      stats &&
        stats.map(({ amount, title, icon }) => (
          <div class="tech-panel p-6 text-center intersect-once motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade intersect-quarter">
            {icon && (
              <div class="flex h-12 w-12 items-center justify-center mx-auto mb-4 rounded-lg border border-primary/20 bg-primary/10 text-primary">
                <Icon name={icon} class="w-10 h-10" />
              </div>
            )}
            {amount && (
              <div class="font-heading text-primary text-[2.6rem] font-bold lg:text-5xl xl:text-6xl">{amount}</div>
            )}
            {title && <div class="text-sm font-semibold uppercase text-muted lg:text-base">{title}</div>}
          </div>
        ))
    }
  </div>
</WidgetWrapper>

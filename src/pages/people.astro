---
import { Icon } from 'astro-icon/components';
import HeroText from '~/components/widgets/HeroText.astro';
import Stats from '~/components/widgets/Stats.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Headline from '~/components/ui/Headline.astro';
import Button from '~/components/ui/Button.astro';
import Image from '~/components/common/Image.astro';
import Layout from '~/layouts/PageLayout.astro';
import { peopleCategories, principalInvestigator } from '~/data/people';

const metadata = {
  title: 'People',
  ignoreTitleTemplate: true,
};

const totalMembers =
  1 +
  peopleCategories.reduce((count, category) => {
    return count + category.members.length;
  }, 0);

const studentResearchers =
  peopleCategories.find((category) => category.title === 'Doctoral Students')!.members.length +
  peopleCategories.find((category) => category.title === 'Master Students')!.members.length +
  peopleCategories.find((category) => category.title === 'Undergraduate Students')!.members.length;

const collaboratorsCount = peopleCategories.find((category) => category.title === 'Collaborators')!.members.length;

const getInitials = (name: string) =>
  name
    .split(' ')
    .filter(Boolean)
    .slice(0, 2)
    .map((part) => part[0])
    .join('')
    .toUpperCase();
---

<Layout metadata={metadata}>
  <HeroText
    tagline="People"
    title={`Meet the <span class="text-primary">HDSP</span> team`}
    subtitle="Researchers, professors, students, and collaborators working together on high-dimensional signal processing, computational imaging, and interdisciplinary scientific innovation."
    callToAction={{
      text: 'Contact HDSP',
      href: '/contact',
      icon: 'tabler:mail',
    }}
    callToAction2={{
      text: 'View Events',
      href: '/events',
      icon: 'tabler:calendar-event',
    }}
  />

  <Stats
    title="Team overview"
    stats={[
      { title: 'People listed', amount: String(totalMembers), classes: { amount: 'text-hdsp-logo-stat text-primary' } },
      {
        title: 'Student researchers',
        amount: String(studentResearchers),
        classes: { amount: 'text-hdsp-logo-stat text-primary' },
      },
      {
        title: 'Collaborators',
        amount: String(collaboratorsCount),
        classes: { amount: 'text-hdsp-logo-stat text-primary' },
      },
      {
        title: 'Categories',
        amount: String(peopleCategories.length + 1),
        classes: { amount: 'text-hdsp-logo-stat text-primary' },
      },
    ]}
  />

  <WidgetWrapper containerClass="max-w-7xl mx-auto">
    <Headline
      title="Leadership"
      subtitle="The HDSP Group is led by a research-oriented academic team with strong experience in signal processing, imaging, optimization, and interdisciplinary collaboration."
      tagline="Principal investigator"
    />

    <article class="tech-panel overflow-hidden">
      <div class="grid gap-0 lg:grid-cols-[280px_minmax(0,1fr)]">
        <div class="border-b border-primary/20 bg-white/45 p-5 dark:bg-white/5 lg:border-b-0 lg:border-r">
          <div
            class="mx-auto max-w-[220px] overflow-hidden rounded-lg border border-primary/20 bg-white/60 shadow-lg dark:bg-white/5"
          >
            <Image
              src={principalInvestigator.image}
              alt={principalInvestigator.name}
              width={520}
              height={520}
              class="h-full w-full object-cover"
              loading="eager"
              decoding="async"
            />
          </div>
        </div>

        <div class="p-5 md:p-6">
          <div class="flex flex-wrap items-start justify-between gap-5">
            <div class="max-w-3xl">
              <p class="tech-kicker mb-3">HDSP leadership</p>
              <h2 class="font-heading text-2xl font-bold tracking-normal text-heading dark:text-white">
                {principalInvestigator.name}
              </h2>
              <p class="mt-2 max-w-3xl text-base text-muted dark:text-slate-300">{principalInvestigator.title}</p>
              {
                principalInvestigator.description && (
                  <p class="mt-4 max-w-3xl text-sm leading-6 text-muted dark:text-slate-300">
                    {principalInvestigator.description}
                  </p>
                )
              }
            </div>

            {
              principalInvestigator.links && principalInvestigator.links.length > 0 && (
                <div class="flex flex-wrap gap-3">
                  {principalInvestigator.links.map((link) => (
                    <Button href={link.href} target="_blank" variant="secondary" icon={link.icon}>
                      {link.label}
                    </Button>
                  ))}
                </div>
              )
            }
          </div>

          <div class="mt-6">
            <h3 class="text-sm font-semibold uppercase text-secondary">Research interests</h3>
            <div class="mt-3 flex flex-wrap gap-2">
              {principalInvestigator.interests.map((interest) => <span class="tech-chip px-3 py-1.5">{interest}</span>)}
            </div>
          </div>
        </div>
      </div>
    </article>
  </WidgetWrapper>

  <WidgetWrapper containerClass="max-w-7xl mx-auto">
    <Headline
      title="Group members"
      subtitle="The team is organized across faculty, students, professional support, and collaborating researchers."
      tagline="By category"
    />

    <div class="space-y-6">
      {
        peopleCategories.map((category) => (
          <section class="border-t border-primary/20 py-6 md:py-8">
            <div class="mb-5 flex flex-wrap items-start justify-between gap-5">
              <div class="max-w-3xl">
                <div class="flex items-center gap-3">
                  <span class="inline-flex h-10 w-10 items-center justify-center rounded-lg border border-primary/20 bg-primary/10 text-primary">
                    <Icon name={category.icon} class="h-5 w-5" />
                  </span>
                  <div>
                    <h2 class="font-heading text-xl font-bold text-heading dark:text-white">{category.title}</h2>
                    <p class="mt-1 text-sm uppercase text-secondary">{category.members.length} members</p>
                  </div>
                </div>
                <p class="mt-3 text-sm leading-6 text-muted">{category.description}</p>
              </div>
            </div>

            <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
              {category.members.map((member) => (
                <article class="tech-panel group p-4 transition-transform duration-200 hover:-translate-y-1">
                  <div class="flex items-start gap-3">
                    <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-[linear-gradient(90deg,rgb(255_38_0)_0_10%,transparent_10%_15%,rgb(255_251_0)_15%_25%,transparent_25%_30%,rgb(45_174_54)_30%_40%,transparent_40%_45%,rgb(4_51_255)_45%_58%,transparent_58%_100%),rgb(4_51_255)] bg-[length:100%_3px,100%_100%] bg-[position:0_0,0_0] bg-no-repeat text-xs font-bold text-white shadow-md [text-shadow:0_1px_2px_rgb(0_0_0_/_65%)]">
                      {getInitials(member.name)}
                    </div>
                    <div class="min-w-0">
                      <h3 class="font-heading text-base font-semibold text-heading dark:text-white">{member.name}</h3>
                      <p class="mt-2 text-sm leading-6 text-muted">{member.title}</p>
                      {member.description && <p class="mt-3 text-sm leading-6 text-muted">{member.description}</p>}
                    </div>
                  </div>

                  {member.links && member.links.length > 0 && (
                    <div class="mt-4 flex flex-wrap gap-2 border-t border-primary/20 pt-3">
                      {member.links.map((link) => (
                        <Button href={link.href} target="_blank" variant="link" icon={link.icon}>
                          {link.label}
                        </Button>
                      ))}
                    </div>
                  )}
                </article>
              ))}
            </div>
          </section>
        ))
      }
    </div>
  </WidgetWrapper>
</Layout>

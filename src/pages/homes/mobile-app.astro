---
const directorAppPath = '/homes/director-app';
const redirectScript = `window.location.replace('${directorAppPath}');`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${directorAppPath}`} />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={directorAppPath} />
    <title>Redirecting to DIRECTOR App</title>
    <script is:inline set:html={redirectScript} />
  </head>
  <body>
    <script is:inline set:html={redirectScript} />
    <a href={directorAppPath}>DIRECTOR App</a>
  </body>
</html>

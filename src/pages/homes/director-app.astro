---
import Layout from '~/layouts/PageLayout.astro';

import Hero2 from '~/components/widgets/Hero2.astro';

const directorAppLogo = '~/assets/images/director-app-logo.jpg';

const metadata = {
  title: 'DIRECTOR App',
};
---

<Layout metadata={metadata}>
  <Fragment slot="announcement"></Fragment>

  <!-- Hero2 Widget ******************* -->

  <Hero2
    tagline="DIRECTOR App"
    image={{
      src: directorAppLogo,
      alt: 'DIRECTOR App logo',
    }}
  >
    <Fragment slot="title">
      <span class="text-accent dark:text-white">DIRECTOR App</span>: <br /> an HDSP app
    </Fragment>

    <Fragment slot="subtitle">
      DIRECTOR App is part of the HDSP Research Group ecosystem. It provides a user-friendly interface to access and explore the group's research output, projects, and news.
    </Fragment>
  </Hero2>
</Layout>

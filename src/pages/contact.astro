---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Features2 from '~/components/widgets/Features2.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Headline from '~/components/ui/Headline.astro';

const metadata = {
  title: 'Contact HDSP',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <HeroText
    tagline="Contact"
    title="Get in touch with HDSP"
    subtitle="You can find the High Dimensional Signal Processing Research Group at Universidad Industrial de Santander in Bucaramanga, Colombia."
    callToAction={{
      text: 'Open in Google Maps',
      href: 'https://www.google.com/maps/place/Escuela+de+Ingenier%C3%ADa+de+Sistemas+e+Informatica/@7.141041,-73.1227711,749m/data=!3m2!1e3!4b1!4m6!3m5!1s0x8e68156d593b824f:0xcf79615cf53f5a2e!8m2!3d7.141041!4d-73.1227711!16s%2Fg%2F1thxm3bw?entry=tts&g_ep=EgoyMDI2MDMxNy4wIPu8ASoASAFQAw%3D%3D&skid=02633685-a003-4960-83d9-17d7486a5394',
      target: '_blank',
      rel: 'noopener noreferrer',
      icon: 'tabler:map-pin',
    }}
    callToAction2={{
      text: 'Email HDSP',
      href: 'mailto:hdsp@uis.edu.co',
      icon: 'tabler:mail',
    }}
  />

  <Features2
    title="Contact information"
    tagline="HDSP research group"
    columns={2}
    items={[
      {
        title: 'Address',
        description:
          'Carrera 27, Calle 9, Edificio Laboratorios Pesados (LP), Of. 333<br />Escuela de Ingeniería de Sistemas e Informática<br />Universidad Industrial de Santander, 680002<br />Bucaramanga, Colombia',
        icon: 'tabler:map-pin',
      },
      {
        title: 'Email',
        description:
          '<a class="text-primary hover:underline" href="mailto:hdsp@uis.edu.co">hdsp@uis.edu.co</a><br /><a class="text-primary hover:underline" href="mailto:henarfu@uis.edu.co">henarfu@uis.edu.co</a>',
        icon: 'tabler:mail',
      },
      {
        title: 'Phone',
        description: '607-6344000<br />Ext. 2476',
        icon: 'tabler:phone',
      },
      {
        title: 'Online',
        description:
          '<a class="text-primary hover:underline" href="https://www.instagram.com/hdspgroup/" target="_blank" rel="noopener noreferrer">Instagram</a><br /><a class="text-primary hover:underline" href="https://github.com/hdspgroup" target="_blank" rel="noopener noreferrer">GitHub</a>',
        icon: 'tabler:brand-instagram',
      },
    ]}
  />

  <WidgetWrapper containerClass="max-w-7xl mx-auto">
    <Headline
      title="Location map"
      subtitle="HDSP research group offices at Universidad Industrial de Santander."
      tagline="Find us"
    />

    <div class="tech-panel overflow-hidden p-2">
      <iframe
        title="HDSP research group location map"
        src="https://www.google.com/maps?output=embed&q=Escuela+de+Ingenieria+de+Sistemas+e+Informatica,+Universidad+Industrial+de+Santander,+Bucaramanga,+Colombia&ll=7.141041,-73.1227711&z=18"
        width="100%"
        height="480"
        style="border:0;"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"></iframe>
    </div>
  </WidgetWrapper>
</Layout>

---
import Content from '~/components/widgets/Content.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Hero from '~/components/widgets/Hero.astro';
import Stats from '~/components/widgets/Stats.astro';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'About HDSP',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <Hero
    tagline="About us"
    image={{
      src: '~/assets/images/hdsp-group-photo-crop.png',
      alt: 'HDSP research group members',
    }}
  >
    <Fragment slot="title">
      High Dimensional Signal Processing <br />
      <span class="text-accent dark:text-white">Research Group</span>
    </Fragment>

    <Fragment slot="subtitle">
      HDSP is an interdisciplinary research group from the Computer Science Department focused on the next generation
      of high-dimensional signal processing algorithms. The group aims to impact Colombian society while contributing
      to the worldwide scientific community.
    </Fragment>
  </Hero>

  <Stats
    title="HDSP at a glance"
    stats={[
      { title: 'MinCiencias classification', amount: 'A1' },
      { title: 'Research laboratories', amount: '2' },
      { title: 'Core research areas', amount: '4' },
      { title: 'Home institution', amount: 'UIS' },
    ]}
  />

  <Content
    title="Research mission and infrastructure"
    tagline="What drives the group"
    image={{
      src: '~/assets/images/hdsp-laboratories-crop.png',
      alt: 'HDSP computational and optical laboratories',
    }}
    items={[
      {
        title: 'Interdisciplinary research',
        description:
          'HDSP connects signal processing, imaging, optimization, and deep learning to address complex scientific problems.',
      },
      {
        title: 'State-of-the-art laboratories',
        description:
          'The group operates modern computational and optical laboratories that support research, academic production, and new projects.',
      },
      {
        title: 'Impact-oriented work',
        description:
          'Its research is designed to create value for Colombian society while maintaining strong international scientific relevance.',
      },
    ]}
  >
    <Fragment slot="content">
      <p>
        Most HDSP research topics involve <strong>optimization techniques</strong> and
        <strong> deep learning algorithms</strong>. This combination supports the design of new imaging systems, the
        reconstruction of missing information, and advanced computational methods for high-dimensional data.
      </p>
    </Fragment>
  </Content>

  <Features2
    title="Research areas"
    tagline="What we study"
    columns={2}
    items={[
      {
        title: 'Deep Learning',
        description:
          'Fundamental research in deep learning enables novel imaging systems to perform high-level tasks such as pose estimation and action recognition in privacy- and safety-sensitive contexts.',
        icon: 'tabler:brain',
      },
      {
        title: 'Spectral Imaging',
        description:
          'Spectral images are a key tool for precision agriculture because they allow recognition of specific characteristics of vegetation and crops across multiple wavelengths.',
        icon: 'tabler:leaf',
      },
      {
        title: 'Seismic Processing and Design',
        description:
          'This line focuses on reconstructing missing seismic data with optimization techniques and deep learning approaches for both 2D and 3D seismic data.',
        icon: 'tabler:wave-sine',
      },
      {
        title: 'Computational Imaging',
        description:
          'The group studies optical coding design and AI-driven reconstruction for tasks such as depth estimation, privacy-preserving imaging, and super-resolution.',
        icon: 'tabler:camera',
      },
    ]}
  />

  <Features2
    title="Collaborations and distinctions"
    tagline="Academic reach"
    columns={4}
    items={[
      {
        title: 'International collaborations',
        description:
          'HDSP maintains an international collaborator network that expands the reach of its research, joint projects, and scientific exchange.',
        icon: 'tabler:world',
      },
      {
        title: 'International patents',
        description:
          'The group highlights patent-oriented results that connect research with technology transfer and practical impact.',
        icon: 'tabler:certificate',
      },
      {
        title: 'UIS awards',
        description:
          'Its trajectory includes institutional recognition through UIS awards and sustained academic excellence.',
        icon: 'tabler:award',
      },
      {
        title: 'PhDs and top researchers',
        description:
          "The poster highlights doctoral training and researcher recognition as part of the group's academic strength.",
        icon: 'tabler:school',
      },
    ]}
  />

  <Features2
    title="Contact"
    tagline="Get in touch"
    columns={2}
    items={[
      {
        title: 'Research lead',
        description:
          'Ph.D Henry Arguello<br /><a class="text-primary hover:underline" href="mailto:henarfu@uis.edu.co">henarfu@uis.edu.co</a>',
        icon: 'tabler:mail',
      },
      {
        title: 'Office',
        description: 'LP 333',
        icon: 'tabler:map-pin',
      },
    ]}
  />
</Layout>

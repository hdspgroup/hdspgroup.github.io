---
import Content from '~/components/widgets/Content.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Hero from '~/components/widgets/Hero.astro';
import Stats from '~/components/widgets/Stats.astro';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'High Dimensional Signal Processing Research Group',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <Hero
    tagline="About us"
    image={{
      src: '~/assets/images/hdsp_2025.jpg',
      alt: 'HDSP research group members',
    }}
  >
    <Fragment slot="title">
      High Dimensional Signal Processing <br />
      <span class="text-primary dark:text-white">Research Group</span>
    </Fragment>

    <Fragment slot="subtitle">
      HDSP is an interdisciplinary research group from the Computer Science Department focused on the next generation
      of high-dimensional signal processing algorithms.
    </Fragment>
  </Hero>

  <Stats
    title="HDSP at a glance"
    stats={[
      { title: 'MinCiencias classification', amount: 'A1' },
      { title: 'Research laboratories', amount: '2' },
      { title: 'Core research areas', amount: '4' },
      { title: 'Home institution', amount: 'UIS' },
    ]}
  />

  <Content
    title="Research mission and infrastructure"
    tagline="What drives the group"
    image={{
      src: '~/assets/images/Grupos-HDSP-UIS-5.jpeg',
      alt: 'HDSP computational and optical laboratories',
    }}
    items={[
      {
        title: 'Interdisciplinary research',
        description:
          'HDSP connects signal processing, imaging, optimization, and artificial intelligence to address complex scientific problems.',
      },
      {
        title: 'State-of-the-art laboratories',
        description:
          'The group operates modern computational and optical laboratories that support research, academic production, and new projects.',
      },
      {
        title: 'Impact-oriented work',
        description:
          'Its research is designed to create value for Colombian society while maintaining strong international scientific relevance.',
      },
    ]}
  >
    <Fragment slot="content">
      <p>
        Most HDSP research topics involve <strong>optimization techniques</strong> and
        <strong> artificial intelligence algorithms</strong>. This combination supports the design of new imaging systems, the
        reconstruction of missing information, and advanced computational methods for high-dimensional data.
      </p>
      <p>
        The group develops computational methods that transform complex measurements into useful information for science,
        engineering, health, agriculture, and geophysics. Its work connects mathematical models, optical and computational
        sensing, and AI-based inference to solve problems where data are large, incomplete, noisy, or difficult to acquire.
      </p>
    </Fragment>
  </Content>

  <Features2
    title="Research areas"
    subtitle="Artificial Intelligence is the group's largest research axis and connects the rest of the areas through learning-based models, optimization, and data-driven sensing."
    tagline="What we study"
    columns={4}
    classes={{
      items: {
        container: 'lg:auto-rows-fr',
        description:
          'leading-relaxed [&_mark]:bg-transparent [&_mark]:font-semibold [&_mark]:text-default [&_mark]:underline [&_mark]:decoration-primary/40 [&_mark]:decoration-2 [&_mark]:underline-offset-4 dark:[&_mark]:text-white dark:[&_mark]:decoration-blue-300/50',
      },
    }}
    items={[
      {
        title: 'Artificial Intelligence',
        description:
          'HDSP develops <mark>AI models</mark> for high-dimensional signals, images, and sensor data. The group works on <mark>learning-based reconstruction</mark>, <mark>classification</mark>, privacy-preserving task learning, and intelligent imaging systems for pose estimation, action recognition, and decision support.',
        icon: 'tabler:brain',
        image: {
          src: '~/assets/images/ai-magazine.png',
          alt: 'Artificial intelligence optical layer and computational decoder diagram',
        },
        classes: {
          panel:
            'sm:col-span-2 lg:row-span-2 bg-primary text-white border-primary p-8 md:p-10 lg:min-h-[360px] shadow-[0_18px_45px_rgba(1,97,239,0.24)] dark:bg-primary dark:text-white dark:border-primary',
          imageWrap: '-mx-8 -mt-8 mb-8 rounded-t-lg bg-[#f4e9eb] p-3 md:-mx-10 md:-mt-10',
          image: 'h-36 !object-contain object-center sm:h-44 md:h-52',
          icon: 'h-16 w-16 text-white',
          title: 'text-3xl md:text-4xl text-white',
          description:
            'max-w-3xl text-white/85 md:text-lg [&_mark]:text-white [&_mark]:decoration-white/70 dark:[&_mark]:text-white',
        },
      },
      {
        title: 'Spectral Imaging',
        description:
          'The group designs <mark>spectral imaging systems</mark> that capture information across multiple wavelengths for <mark>precision agriculture</mark>, material analysis, crop monitoring, and visual patterns that standard RGB cameras cannot observe.',
        icon: 'tabler:leaf',
        image: {
          src: '~/assets/images/Grupos-HDSP-UIS-5.jpeg',
          alt: 'HDSP optical laboratory equipment for spectral imaging research',
        },
      },
      {
        title: 'Seismic Processing and Design',
        description:
          'HDSP combines <mark>optimization</mark> and <mark>artificial intelligence</mark> for 2D and 3D seismic data, recovering missing information, improving subsurface imaging, and designing more efficient sensing strategies for geophysical exploration.',
        icon: 'tabler:wave-sine',
        image: {
          src: '~/assets/images/seismic-reconstruction.png',
          alt: 'Seismic reconstruction workflow with neural network and physics-guided loss',
        },
        classes: {
          imageWrap: 'bg-white',
          image: 'object-center',
        },
      },
      {
        title: 'Computational Imaging',
        description:
          'This area connects <mark>optical coding</mark>, inverse problems, and AI-driven reconstruction for computational cameras, coded sensing systems, depth estimation, <mark>privacy-preserving imaging</mark>, super-resolution, and task-oriented visual analysis.',
        icon: 'tabler:camera',
        image: {
          src: '~/assets/images/computational-imaging.png',
          alt: 'Computational imaging system with optical coding and digital decoding',
        },
        classes: {
          panel: 'lg:col-span-2',
          imageWrap: 'bg-black',
          image: '!object-contain object-center hover:scale-100',
        },
      },
    ]}
  />

  <Features2
    title="Collaborations and distinctions"
    tagline="Academic reach"
    columns={4}
    items={[
      {
        title: 'International collaborations',
        description:
          'HDSP maintains an international collaborator network that expands the reach of its research, joint projects, and scientific exchange.',
        icon: 'tabler:world',
      },
      {
        title: 'International patents',
        description:
          'The group highlights patent-oriented results that connect research with technology transfer and practical impact.',
        icon: 'tabler:certificate',
      },
      {
        title: 'UIS awards',
        description:
          'Its trajectory includes institutional recognition through UIS awards and sustained academic excellence.',
        icon: 'tabler:award',
      },
      {
        title: 'PhDs and top researchers',
        description:
          "The poster highlights doctoral training and researcher recognition as part of the group's academic strength.",
        icon: 'tabler:school',
      },
    ]}
  />

</Layout>

---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Stats from '~/components/widgets/Stats.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Headline from '~/components/ui/Headline.astro';
import Button from '~/components/ui/Button.astro';
import publicationsData from '~/data/openalex-publications.json';

interface Publication {
  id: string;
  title: string;
  publicationDate: string | null;
  publicationYear: number | null;
  doi: string | null;
  doiUrl: string | null;
  type: string | null;
  typeCrossref: string | null;
  authors: string[];
  authorsCount: number;
  venue: string | null;
  venueType: string | null;
  topics: string[];
  bestOaLocation?: {
    landingPageUrl?: string | null;
    pdfUrl?: string | null;
  } | null;
  primaryLocation?: {
    landingPageUrl?: string | null;
    pdfUrl?: string | null;
  } | null;
}

interface PublicationsDataset {
  fetchedAt: string;
  totals: {
    openAlexWorks: number;
    worksWithDoi: number;
    doiBackedWorks: number;
    omittedWithoutDoiCount: number;
    omittedUnavailableMetadataCount: number;
  };
  profile: {
    name: string;
    worksCount: number;
    citedByCount: number;
    openAlexUrl: string | null;
    orcid: string | null;
    institutions: string[];
  };
  publications: Publication[];
}

const dataset = publicationsData as PublicationsDataset;
const publications = (dataset.publications ?? []).filter((publication) => (publication.publicationYear ?? 0) >= 2010);
const profile = dataset.profile;
const totals = dataset.totals;
const scholarProfileUrl = 'https://scholar.google.com/citations?user=R7gjbGIAAAAJ&hl=en';
const normalizeArguello = (value: string) => value.replaceAll('Argüello', 'Arguello');
const profileName = normalizeArguello(profile.name);
const profileDisplayName = `Professor ${profileName}`;

const metadata = {
  title: 'Publications',
  description: `Publications for ${profileDisplayName}.`,
};

const formatDate = (value: string | null) =>
  value
    ? new Date(`${value}T00:00:00Z`).toLocaleDateString('en-US', {
        year: 'numeric',
        month: 'short',
        day: 'numeric',
        timeZone: 'UTC',
      })
    : null;

const formatAuthors = (authors: string[], max = 8) => {
  if (!authors.length) return null;
  const normalizedAuthors = authors.map(normalizeArguello);
  if (normalizedAuthors.length <= max) return normalizedAuthors.join(', ');
  return `${normalizedAuthors.slice(0, max).join(', ')} +${normalizedAuthors.length - max} more`;
};

const formatVenue = (publication: Publication) => {
  const parts = [publication.venue, publication.venueType].filter(Boolean);
  return parts.length ? parts.join(' | ') : null;
};

const linkForPublication = (publication: Publication) =>
  publication.bestOaLocation?.landingPageUrl || publication.primaryLocation?.landingPageUrl || publication.doiUrl;

const years = Array.from(new Set(publications.map((publication) => publication.publicationYear).filter(Boolean))).sort(
  (a, b) => Number(b) - Number(a)
);

const groupedPublications = years.map((year) => ({
  year,
  publications: publications.filter((publication) => publication.publicationYear === year),
}));

const latestUpdate = new Date(dataset.fetchedAt).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
---

<Layout metadata={metadata}>
  <HeroText
    tagline="Publications"
    title={`Research output by ${profileDisplayName}`}
    subtitle={`Weekly updated.`}
    callToAction={{
      text: 'Google Scholar profile',
      href: scholarProfileUrl,
      target: '_blank',
      rel: 'noopener noreferrer',
      icon: 'tabler:external-link',
    }}
    callToAction2={profile.orcid
      ? {
          text: 'ORCID',
          href: profile.orcid,
          target: '_blank',
          rel: 'noopener noreferrer',
          icon: 'tabler:id-badge-2',
        }
      : undefined}
  />

  <Stats
    title="At a glance"
    stats={[
      { title: 'Visible works', amount: String(publications.length) },
      { title: 'Profile works', amount: String(totals.openAlexWorks ?? profile.worksCount) },
      { title: 'Years covered', amount: String(years.length) },
      { title: 'Works with DOI', amount: String(totals.worksWithDoi ?? totals.doiBackedWorks) },
    ]}
  />

  <WidgetWrapper containerClass="max-w-7xl mx-auto">
    <Headline
      title="Publication list"
      subtitle={`Primary institution: ${profile.institutions[0] ?? 'Not available'}.<br />Last synchronized on ${latestUpdate}.`}
    />

    <div class="space-y-6">
      {
        groupedPublications.map(({ year, publications: items }, index) => (
          <details class="border-t border-primary/20 py-6" open={index < 3}>
            <summary class="flex cursor-pointer list-none flex-wrap items-center justify-between gap-3">
              <div>
                <h2 class="text-2xl font-bold font-heading dark:text-white">{year}</h2>
                <p class="text-sm text-muted">{items.length} publications</p>
              </div>
              <span class="text-sm font-semibold text-primary">Toggle year</span>
            </summary>

            <div class="mt-6 space-y-4">
              {items.map((publication) => (
                <article class="tech-panel p-5">
                  <div class="flex flex-wrap items-start justify-between gap-4">
                    <div class="max-w-4xl">
                      <h3 class="text-lg font-semibold font-heading dark:text-white">
                        {linkForPublication(publication) ? (
                          <a
                            href={linkForPublication(publication)}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="hover:text-primary"
                          >
                            {publication.title}
                          </a>
                        ) : (
                          publication.title
                        )}
                      </h3>
                      {formatVenue(publication) && <p class="mt-2 text-sm text-muted">{formatVenue(publication)}</p>}
                      {formatAuthors(publication.authors) && (
                        <p class="mt-2 text-sm text-muted">{formatAuthors(publication.authors)}</p>
                      )}
                    </div>

                    <div class="min-w-[150px] text-left md:text-right">
                      {publication.publicationDate && (
                        <p class="text-sm text-muted">{formatDate(publication.publicationDate)}</p>
                      )}
                    </div>
                  </div>

                  <div class="mt-4 flex flex-wrap items-center gap-2">
                    {publication.doiUrl && (
                      <Button href={publication.doiUrl} target="_blank" variant="link" icon="tabler:link">
                        DOI
                      </Button>
                    )}
                    {publication.bestOaLocation?.pdfUrl && (
                      <Button
                        href={publication.bestOaLocation.pdfUrl}
                        target="_blank"
                        variant="link"
                        icon="tabler:file-type-pdf"
                      >
                        PDF
                      </Button>
                    )}
                  </div>

                  {publication.topics.length > 0 && (
                    <div class="mt-4 flex flex-wrap gap-2">
                      {publication.topics.map((topic) => (
                        <span class="tech-chip text-xs">{topic}</span>
                      ))}
                    </div>
                  )}
                </article>
              ))}
            </div>
          </details>
        ))
      }
    </div>
  </WidgetWrapper>
</Layout>
